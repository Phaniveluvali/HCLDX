          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "title": "Name",
                "description": "Name suffix of the PVC - must be unique in the array",
                "type": "string"
              },
              "accessModes": {
                "title": "Access Modes",
                "description": "PVC access modes - list of modes each of which must be one of ReadWriteOnce, ReadOnlyMany, ReadWriteMany",
                "type": [
                  "array"
                ],
                "items": {
                  "type": "string",
                  "enum": [
                    "ReadWriteOnce",
                    "ReadOnlyMany",
                    "ReadWriteMany"
                  ]
                }
              },
              "mountPath": {
                "title": "Mount Path",
                "description": "Path in the core container where the volume will be mounted",
                "type": "string"
              },
              "storageClassName": {
                "title": "Storage Class Name",
                "description": "The StorageClassName of the persistent volume that should be used to fulfill the Persistent Volume Claim.",
                "type": "string"
              },
              "requests": {
                "title": "Requests",
                "description": "The persistent volume requests",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "storage": {
                    "title": "Storage",
                    "description": "The storage request for the persistent volume claim",
                    "type": "string"
                  }
                },
                "required": [
                  "storage"
                ]
              },
              "selector": {
                "title": "Label selector",
                "description": "Optional label selector to further filter the set of volumes. Only the volumes whose labels match the selector can be bound to the claim.",
                "$ref": "#/definitions/persistentVolumeClaimSelectorSchema"
              },
              "volumeName": {
                "title": "Volume Name",
                "description": "Optional volume name that can be set to map a specific existing volume.",
                "type": [
                  "null",
                  "string"
                ]
              }
            },
            "required": [
              "name",
              "accessModes",
              "mountPath",
              "storageClassName",
              "requests"
            ]
          }
        }
      },
      "required": [
        "data",
        "customPVCs"
      ]
    },
